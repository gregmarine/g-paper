<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.symmetricalpalmtree.gpaper.probeseam.BIND" />
    <queries>
        <package android:name="com.symmetricalpalmtree.gpaper.probeseam.hub" />
    </queries>
    <application
        android:name=".ProbeApplication"
        android:label="Seam probe"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PageActivity" android:exported="true" />
    </application>
</manifest>
